        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string",
                    "pattern": "^usr_[0-9a-f]{32}$"
                  }
                },
                "required": ["userId"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The user is a member (with the Organization status), or is not.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "found": {
                          "type": "boolean",
                          "enum": [true]
                        },
                        "organizationId": {
                          "type": "string",
                          "pattern": "^org_[0-9a-f]{32}$"
                        },
                        "role": {
                          "type": "string",
                          "enum": ["owner", "admin", "manager", "rep"]
                        },
                        "organizationStatus": {
                          "type": "string",
                          "enum": ["active", "suspended", "deleted"]
                        }
                      },
                      "required": ["found", "organizationId", "role", "organizationStatus"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "found": {
                          "type": "boolean",
                          "enum": [false]
                        }
                      },
                      "required": ["found"]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The request or the Idempotency-Key header is not valid.",
            "content": {
