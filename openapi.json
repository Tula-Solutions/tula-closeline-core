    "/internal/membership": {
      "post": {
        "tags": ["internal"],
        "summary": "Look up the membership of a user",
        "description": "Called only by the auth service, from the token hook on every sign-in and refresh. Two indexed reads. A user with no membership is answered found: false, not an error.",
        "security": [
          {
            "internalSecret": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "required": true,
            "name": "idempotency-key",
