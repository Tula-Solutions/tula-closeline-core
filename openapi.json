                        },
                        "message": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": {}
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "401": {
            "description": "The internal secret is missing or wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "maxLength": 100,
                          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
                        },
