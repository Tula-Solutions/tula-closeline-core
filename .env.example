# Local values for every environment key (src/env.ts). Copy to .env, which is never committed.
# ENVIRONMENT has no default: a process without it fails at boot.
ENVIRONMENT=local
PORT=3000
LOG_LEVEL=debug
# Longest one readiness check may take, in ms.
READINESS_TIMEOUT_MS=2000
# Longest shutdown waits for in-flight requests before closing them, in ms.
SHUTDOWN_TIMEOUT_MS=10000
# How long /readyz answers 503 before the server stops accepting, in ms. 0 locally.
SHUTDOWN_GRACE_MS=0
# Largest request body accepted, in bytes (1 MB).
MAX_REQUEST_BODY_BYTES=1048576
# The Region this deployment serves (us|eu). Every Organization created here lives in it.
REGION=us
# Postgres as the closeline_core login (the compose setup's local password; never a real one).
DATABASE_URL=postgres://closeline_core:closeline_core_local@127.0.0.1:5432/closeline
# The auth service: where its signing keys are published, and the iss and aud of its tokens.
AUTH_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AUTH_ISSUER=http://127.0.0.1:3001
AUTH_AUDIENCE=closeline
# Secrets the auth service presents to /internal, comma separated, each 32 to 512 printable
# characters with no space. List the new secret beside the old one to rotate without downtime.
# Required outside local. This one is for local use only.
INTERNAL_API_TOKENS=local-only-internal-secret-change-me-0123456789
# Voice's internal base URL and secret, read for an Assessment's transcript. Set together; https and
# required outside local. Unset locally, the transcript comes from the memory reader.
# VOICE_INTERNAL_URL=http://127.0.0.1:3004
# VOICE_INTERNAL_TOKEN=local-only-voice-internal-secret-0123456789
# Where the portal is served: the base of the link in an invitation email (the token goes in the
# URL fragment). https outside local, no query or fragment. Required outside local.
PORTAL_BASE_URL=http://127.0.0.1:3002
# HubSpot connection (OAuth). Both turn it on; without them every CRM start is refused. HubSpot
# redirects back to {PORTAL_BASE_URL}/integrations/hubspot/callback, which the portal finishes with
# POST /v1/crm/connections/hubspot/completions. HUBSPOT_API_URL and HUBSPOT_AUTHORISE_URL point at
# a stand-in and are accepted only when ENVIRONMENT=local.
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# Longest the invitation mail adapter may take to hand over one message, in ms.
INVITATION_DELIVERY_TIMEOUT_MS=5000
# Outbox drain: rows claimed per pass (1 to 100), rest between passes (ms), how long a claim holds
# its rows (ms; at least 2 x ceil(batch / 10) publish timeouts) and the cap on one publish (ms).
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=60000
OUTBOX_PUBLISH_TIMEOUT_MS=5000
# A local mailbox (Mailpit) that takes Invitation mail, written exactly http://127.0.0.1,
# http://[::1] or http://localhost, with an optional :port. Accepted only when ENVIRONMENT=local;
# any other environment or spelling fails at boot. Leave the line out to unset it: a blank value is
# refused at boot. Unset, the mailer is unconfigured and creating an Invitation fails and revokes it.
# MAIL_LOCAL_URL=http://127.0.0.1:8025
# The From address of local mail (default no-reply@closeline.test). Also local only.
# MAIL_LOCAL_FROM=no-reply@closeline.test
# The secret that signs the unsubscribe link of an email, 32 to 512 printable characters. Required
# outside local; changing it makes every link already sent invalid. This one is for local use only.
UNSUBSCRIBE_TOKEN_KEY=local-unsubscribe-key-not-a-secret-0123456789
# The secret booking link tokens are derived from, 32 to 512 printable characters. Used for nothing
# else. Required outside local; changing it changes every link already shared. Local use only.
BOOKING_LINK_KEY=local-booking-link-key-not-a-secret-0123456789

# Set to bedrock to classify and draft Replies with Claude on Amazon Bedrock in AWS_REGION (needs AWS credentials).
# Unset: keyword stand-ins in local, unconfigured adapters elsewhere.
# REPLY_MODEL=bedrock
